{
  "name": "@adobe/aem-boilerplate",
  "private": true,
  "version": "1.3.0",
  "description": "Starter project for Adobe Helix",
  "scripts": {
    "lint:js": "eslint .",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "build:react": "vite build",
    "watch:react": "vite build --watch",
    "dev:react": "vite",
    "serve": "npx -y @adobe/aem-cli up --no-open --forward-browser-logs",
    "proxy": "node tools/cors-proxy.mjs",
    "start": "trap 'kill 0' SIGINT EXIT; npm run watch:react & npm run proxy & npm run serve"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-boilerplate.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-boilerplate/issues"
  },
  "homepage": "https://github.com/adobe/aem-boilerplate#readme",
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.7",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "vite": "8.2.1"
  },
  "dependencies": {
    "jsencrypt": "^3.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.2.1"
  }
}
